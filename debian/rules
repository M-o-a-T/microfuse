#!/usr/bin/make -f

export PYBUILD_NAME=microfuse
# Force the pyproject backend end-to-end; otherwise pybuild falls back to the
# Makefile (sourcemgr), whose `install` target cross-compiles .mpy for the
# embedded target and whose build target couples to the test suite.
export PYBUILD_SYSTEM=pyproject

%:
	dh $@ --with python3

# The test suite spins up micropython, unavailable on build daemons.
override_dh_auto_test:

# Build the wheel directly. Pybuild's pyproject backend would otherwise delegate
# `build` to make, whose target (via sourcemgr) drags in the test suite.
override_dh_auto_build:
	pybuild --build

# Install the wheel into the staging tree. dh_auto_install does not reliably
# run pybuild's install step once build has been overridden, so drive it
# ourselves; dh_python3 (later in the sequence) derives ${python3:Depends}.
override_dh_auto_install:
	pybuild --install --dest debian/tmp
	# Ship the systemd unit and GPIO helper scriptlets.
	install -Dm0644 systemd/microfuse.service \
		debian/python3-microfuse/lib/systemd/system/microfuse.service
	install -Dm0755 systemd/gpio-on.sh \
		debian/python3-microfuse/usr/lib/microfuse/gpio-on.sh
	install -Dm0755 systemd/gpio-off.sh \
		debian/python3-microfuse/usr/lib/microfuse/gpio-off.sh
